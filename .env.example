# Option A: Claude (paid API key from console.anthropic.com)
ANTHROPIC_API_KEY=
# SAQI_MODEL=claude-sonnet-5-5

# Option B: DeepSeek through its Anthropic-compatible endpoint (same code, no changes)
# ANTHROPIC_API_KEY=<your DeepSeek key>
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# SAQI_MODEL=deepseek-flash

# Option C: Gemini free tier, or any OpenAI-format API.
# Uncomment these. While SAQI_PROVIDER=openai, the Anthropic key above is ignored.
# Gemini key: https://aistudio.google.com/apikey
# SAQI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SAQI_MODEL=gemini-3.8-flash
