# Option A: Claude (paid API key from console.anthropic.com)
ANTHROPIC_API_KEY=
# SAQI_MODEL=claude-sonnet-5-5

# Option B: DeepSeek through its Anthropic-compatible endpoint (same code, no changes)
# ANTHROPIC_API_KEY=<your DeepSeek key>
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# SAQI_MODEL=deepseek-flash

# Option C: Gemini free tier, or any OpenAI-format API.
# Uncomment these. While SAQI_PROVIDER=openai, the Anthropic key above is ignored.
# Gemini key: https://aistudio.google.com/apikey
# SAQI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SAQI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded (503) or rate-limited (429).
# Comma-separated; a name your account does not have is skipped.
# SAQI_FALLBACK_MODEL=gemini-3.7-flash,gemini-3.5-flash-lite

# Optional. If set, every /api route requires this code (header X-Saqi-Code, or POST /api/login).
# SAQI_ACCESS_CODE=

# Optional. Postgres for the pilot log. Supabase: Connect → Session pooler (IPv4, port 5432).
# DATABASE_URL=
